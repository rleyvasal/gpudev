# ── gpudev cloudflare ─────────────────────────────────────────────────────────

cmd_cloudflare_token_set() {
    require_host_setup
    local token="${1:-}"
    if [ -z "$token" ]; then
        echo "Paste a Cloudflare API token with Zone.DNS Edit for your domain."
        echo "Create one: https://dash.cloudflare.com/profile/api-tokens"
        echo "  → Create Token → 'Edit zone DNS' → zone = your CF_DOMAIN"
        echo ""
        read -r -p "Token: " token
    fi
    [ -n "$token" ] || fail "Empty token."
    python3 -c "
import json, pathlib, sys
p = pathlib.Path('${HOST_CONFIG}')
d = json.loads(p.read_text()) if p.exists() else {}
d['cf_api_token'] = sys.argv[1]
p.write_text(json.dumps(d, indent=2))
" "$token"
    chmod 600 "$HOST_CONFIG"
    log "cf_api_token saved to $HOST_CONFIG (chmod 600)."
    log "client remove will use it to delete CNAMEs automatically."
}

cmd_cloudflare() {
    # gpudev cloudflare [status|token-set [TOKEN]]
    local sub="${1:-status}"
    case "$sub" in
        status|"") ;;
        token-set|token)
            cmd_cloudflare_token_set "${2:-}"
            return 0
            ;;
        help|-h|--help)
            echo "Usage: gpudev cloudflare [status|token-set [TOKEN]]"
            echo "  status      tunnel + ingress + DNS + edge check (default)"
            echo "  token-set   store Zone.DNS Edit API token in host.json"
            return 0
            ;;
        *)
            fail "Usage: gpudev cloudflare [status|token-set [TOKEN]]"
            ;;
    esac

    require_host_setup

    local config_yml="${HOME}/.cloudflared/config.yml"
    local tunnel_log="${HOME}/.cloudflared/tunnel.log"
    local host_cf_hostname tunnel_name
    host_cf_hostname="$(host_get host_cf_hostname)"
    tunnel_name="$(host_get linux_user)"

    echo "gpudev Cloudflare Tunnel Status"
    echo ""
    echo "  Host tunnel hostname:  ${host_cf_hostname:-<unset>}"
    command_exists cloudflared \
        && echo "  cloudflared:           OK ($(cloudflared --version 2>&1 | head -1))" \
        || echo "  cloudflared:           MISSING"
    echo ""

    # Connector process: prefer systemd unit when present, otherwise look for the
    # nohup'd background process started by linux-setup.sh on WSL2 hosts.
    echo "── Connector ──"
    echo ""
    if [ -f /etc/systemd/system/gpudev-tunnel.service ] && command_exists systemctl; then
        local active
        active="$(systemctl is-active gpudev-tunnel 2>/dev/null || true)"
        echo "  Mode:     systemd (gpudev-tunnel.service)"
        echo "  Active:   ${active:-unknown}"
        systemctl status gpudev-tunnel --no-pager -n 0 2>/dev/null \
            | grep -E '^\s*(Active|Main PID):' | sed 's/^/  /'
        # A connector older than the last ingress edit is still serving stale
        # rules: the container is up and config.yml is right, but the client's
        # hostname answers "websocket: bad handshake". Say so here instead of
        # leaving it to be rediscovered from the outside.
        if connector_is_current; then
            echo "  Config:   current (started after the last ingress change)"
        else
            echo "  Config:   STALE — started BEFORE the last ingress change."
            echo "            Clients added since then are NOT reachable through the tunnel."
            echo "            Fix: sudo systemctl restart gpudev-tunnel"
        fi
    else
        local pids
        pids="$(pgrep -af 'cloudflared tunnel run' 2>/dev/null || true)"
        if [ -n "$pids" ]; then
            echo "  Mode:     background process (no systemd)"
            echo "  Running:"
            echo "$pids" | sed 's/^/    /'
        else
            echo "  Mode:     background process (no systemd)"
            echo "  Running:  NOT RUNNING"
        fi
    fi
    echo ""

    # Ingress: parse the lines we wrote in linux-setup.sh / client-setup.sh.
    if [ -f "$config_yml" ]; then
        echo "── Ingress (${config_yml}) ──"
        echo ""
        # Pair each "hostname:" with the following "service:" line.
        awk '
            /^\s*-\s*hostname:/ { host=$0; sub(/^\s*-\s*hostname:\s*/, "", host); next }
            /^\s*service:/      { svc=$0; sub(/^\s*service:\s*/, "", svc);
                                  if (host != "") { printf "  %-40s → %s\n", host, svc; host=""; next }
                                  printf "  %-40s   %s\n", "<catch-all>", svc
                                }
        ' "$config_yml"
        echo ""
    else
        echo "  No tunnel config at $config_yml"
        echo ""
    fi

    # DNS route check: does the hostname's CNAME actually point at the tunnel
    # this connector runs? A mismatch is invisible in `systemctl status` (the
    # connector looks healthy) yet yields HTTP 530 for the hostname — the exact
    # failure we hit after renaming the tunnel. The CNAME target is proxied, so
    # `dig` can't see it; read it from the Cloudflare API (token from host.json)
    # and compare its UUID against config.yml's `tunnel:` UUID.
    if [ -f "$config_yml" ] && [ -n "$host_cf_hostname" ]; then
        echo "── DNS route ──"
        echo ""
        local cfg_uuid cf_domain cf_api_token
        cfg_uuid="$(awk '/^tunnel:/ {print $2; exit}' "$config_yml")"
        cf_domain="$(host_get cf_domain)"
        cf_api_token="$(host_get cf_api_token)"

        if [ -z "$cfg_uuid" ]; then
            echo "  config.yml has no 'tunnel:' UUID — cannot check."
        elif [ -z "$cf_api_token" ] || [ -z "$cf_domain" ] || ! command_exists curl; then
            echo "  Connector runs tunnel:  $cfg_uuid"
            echo "  (target check skipped — needs cf_api_token + cf_domain in host.json + curl)"
        else
            local zone_id cname_target dns_uuid
            zone_id="$(curl -sf \
                -H "Authorization: Bearer ${cf_api_token}" \
                "https://api.cloudflare.com/client/v4/zones?name=${cf_domain}&status=active" \
                | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['result'][0]['id'] if d.get('result') else '')" 2>/dev/null || true)"
            if [ -z "$zone_id" ]; then
                echo "  Connector runs tunnel:  $cfg_uuid"
                echo "  (could not resolve zone '$cf_domain' via API — check cf_api_token)"
            else
                cname_target="$(curl -sf \
                    -H "Authorization: Bearer ${cf_api_token}" \
                    "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records?name=${host_cf_hostname}&type=CNAME" \
                    | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['result'][0]['content'] if d.get('result') else '')" 2>/dev/null || true)"
                dns_uuid="${cname_target%.cfargotunnel.com}"
                echo "  Connector runs tunnel:  $cfg_uuid"
                if [ -z "$cname_target" ]; then
                    echo "  Hostname CNAME:         <not readable>"
                    echo "  Could not read a CNAME for $host_cf_hostname — it is either"
                    echo "  missing, or cf_api_token lacks DNS read. If 530 persists, run:"
                    echo "    cloudflared tunnel route dns --overwrite-dns ${tunnel_name:-<tunnel>} ${host_cf_hostname}"
                elif [ "$dns_uuid" = "$cfg_uuid" ]; then
                    echo "  Hostname CNAME:         $cname_target"
                    echo "  OK — DNS points at the running tunnel."
                else
                    echo "  Hostname CNAME:         $cname_target"
                    echo "  MISMATCH — DNS points at tunnel $dns_uuid, not the running $cfg_uuid."
                    echo "  This is the HTTP 530 cause. Re-point it:"
                    echo "    cloudflared tunnel route dns --overwrite-dns ${tunnel_name:-<tunnel>} ${host_cf_hostname}"
                fi
            fi
        fi
        echo ""
    fi

    # Edge check. Probes EVERY ingress hostname, not just the host's: a client
    # whose route never reached the connector is otherwise invisible here — the
    # container is up, config.yml holds the rule, `systemctl status` is green,
    # and the only symptom is an ssh error on the notebook machine that names
    # nothing about tunnels.
    #
    # For ssh:// rules this speaks SSH, NOT HTTPS. An HTTPS probe cannot see the
    # failure it is meant to catch: Cloudflare Access answers at the edge with a
    # login page (HTTP 200) before the connector is ever consulted, and a
    # hostname the connector does not serve falls to the `http_status:404`
    # catch-all — both look "reachable". Reading the origin's SSH banner through
    # `cloudflared access tcp` is the same path the notebook takes, so it proves
    # DNS + edge + connector ingress + a live origin sshd. Measured at ~0.6s per
    # hostname. Hostnames come from config.yml because that is what the
    # connector actually serves.
    probe_edge_ssh() {
        local h="$1" port=$((40000 + RANDOM % 9000)) pid banner=""
        timeout 20 cloudflared access tcp --hostname "$h" --url "127.0.0.1:${port}" \
            >/dev/null 2>&1 &
        pid=$!
        local i
        for i in $(seq 1 30); do
            (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null && break
            sleep 0.3
        done
        banner="$(timeout 8 bash -c "exec 3<>/dev/tcp/127.0.0.1/${port}; head -c 8 <&3" 2>/dev/null || true)"
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        printf '%s' "$banner"
    }

    report_edge_http() {
        local host="$1" label="$2" code
        code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 \
                "https://${host}" 2>/dev/null || echo '---')"
        case "$code" in
            200|301|302|400|401|403|404)
                echo "  ${label} ${host} → HTTP $code (edge reachable)" ;;
            502|503|504)
                echo "  ${label} ${host} → HTTP $code (tunnel up, ORIGIN DOWN)" ;;
            530|1033)
                echo "  ${label} ${host} → HTTP $code (TUNNEL NOT CONNECTED to Cloudflare)"
                echo "         → see the DNS route section above (likely a stale CNAME)." ;;
            ---|000)
                echo "  ${label} ${host} → unreachable / timeout" ;;
            *)
                echo "  ${label} ${host} → HTTP $code" ;;
        esac
    }

    if [ -f "$config_yml" ] && { command_exists cloudflared || command_exists curl; }; then
        echo "── Edge reachability ──"
        echo ""
        local pairs h svc label banner probed=0
        pairs="$(awk '
            /^[[:space:]]*-[[:space:]]*hostname:/ { sub(/^[[:space:]]*-[[:space:]]*hostname:[[:space:]]*/, ""); host=$0; next }
            /^[[:space:]]*service:/ { sub(/^[[:space:]]*service:[[:space:]]*/, "");
                                      if (host != "") { print host "\t" $0; host="" } }
        ' "$config_yml")"
        if [ -z "$pairs" ]; then
            echo "  (no ingress hostnames in $config_yml)"
        else
            while IFS="$(printf '\t')" read -r h svc; do
                [ -n "$h" ] || continue
                probed=1
                if [ "$h" = "$host_cf_hostname" ]; then label="host  "; else label="client"; fi
                case "$svc" in
                    ssh://*)
                        if ! command_exists cloudflared; then
                            report_edge_http "$h" "$label"
                            continue
                        fi
                        banner="$(probe_edge_ssh "$h")"
                        case "$banner" in
                            SSH-2.0*)
                                echo "  ${label} ${h} → OK (origin sshd answered through the tunnel)" ;;
                            "")
                                echo "  ${label} ${h} → NO SSH BANNER — the tunnel does not reach this origin."
                                echo "         → connector may predate this rule (see Connector 'Config:' above):"
                                echo "           sudo systemctl restart gpudev-tunnel"
                                echo "         → or the container is down: gpudev client list" ;;
                            *)
                                echo "  ${label} ${h} → unexpected reply through the tunnel: ${banner}" ;;
                        esac
                        ;;
                    *)
                        if command_exists curl; then report_edge_http "$h" "$label"; fi
                        ;;
                esac
            done <<< "$pairs"
            [ "$probed" = "1" ] || echo "  (no probeable ingress hostnames)"
        fi
        echo ""
    fi

    # Recent log tail — usually has the real reason when something is wrong.
    # Under systemd the connector logs to journald, NOT to tunnel.log (that file
    # is only written by the nohup fallback path), so prefer journalctl when the
    # unit is present and fall back to the file otherwise.
    if [ -f /etc/systemd/system/gpudev-tunnel.service ] && command_exists journalctl; then
        echo "── Last 10 log lines (journalctl -u gpudev-tunnel) ──"
        echo ""
        journalctl -u gpudev-tunnel -n 10 --no-pager 2>/dev/null | sed 's/^/  /' \
            || echo "  (run with sudo to read the journal: sudo journalctl -u gpudev-tunnel -n 50)"
    elif [ -f "$tunnel_log" ]; then
        echo "── Last 10 lines of tunnel.log ──"
        echo ""
        tail -10 "$tunnel_log" | sed 's/^/  /'
    fi

    local tok
    tok="$(host_get cf_api_token)"
    echo ""
    echo "── API token (DNS cleanup) ──"
    echo ""
    if [ -n "$tok" ]; then
        echo "  cf_api_token: present in host.json (used by client remove)"
    else
        echo "  cf_api_token: MISSING — client remove cannot delete DNS automatically"
        echo "  Fix:  gpudev cloudflare token-set"
    fi
    echo ""
}

# ── gpudev disk ───────────────────────────────────────────────────────────────

cmd_disk() {
    require_host_setup

    echo "gpudev Disk Usage"
    echo ""

    echo "── Host root filesystem ──"
    echo ""
    df -h / 2>/dev/null | sed 's/^/  /'
    echo ""

    # If Docker's data root is on a separate filesystem (common on bare Linux),
    # show that too.
    local docker_root
    docker_root="$(docker_cmd info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
    if [ -n "$docker_root" ] && [ "$docker_root" != "/var/lib/docker" ]; then
        echo "── Docker data root (${docker_root}) ──"
        echo ""
        df -h "$docker_root" 2>/dev/null | sed 's/^/  /'
        echo ""
    fi

    if docker_cmd info >/dev/null 2>&1; then
        echo "── Docker (images / containers / volumes) ──"
        echo ""
        docker_cmd system df 2>/dev/null | sed 's/^/  /'
        echo ""

        echo "── Per-client volumes ──"
        echo ""
        # `system df -v` includes a "Local Volumes space usage" section with
        # per-volume sizes. Print just that block.
        docker_cmd system df -v 2>/dev/null | awk '
            /^Local Volumes space usage:/ { p=1; next }
            p && NF==0 { p=0 }
            p
        ' | sed 's/^/  /'
        echo ""
    else
        echo "  Docker not reachable — skipping container/volume usage."
        echo ""
    fi
}

# ── gpudev power ──────────────────────────────────────────────────────────────

# Resolve the WSL interop socket so Windows .exe calls work from a non-login
# session (e.g. a command run over SSH). sshd does not inherit WSL_INTEROP, and
# without it the binfmt handler that launches Windows executables has no socket
# to talk to — shutdown.exe/rundll32.exe would fail silently. Pick the most
# recent live socket under /run/WSL (named <pid>_interop).
ensure_wsl_interop() {
    if [ -z "${WSL_INTEROP:-}" ] || [ ! -S "${WSL_INTEROP:-}" ]; then
        local sock
        sock="$(ls -t /run/WSL/*_interop 2>/dev/null | head -1 || true)"
        if [ -n "$sock" ]; then
            export WSL_INTEROP="$sock"
        fi
    fi
    return 0
}

execute_power_action() {
    local action="$1"
    require_host_setup
    local host_env
    host_env="$(host_get host_env)"

    case "$host_env" in
        wsl2)
            # WSL2 can't suspend/reboot Windows itself — drive the Windows host
            # via interop. GPUDEV_POWER_DRYRUN lets tests exercise the routing
            # without actually cycling the machine.
            ensure_wsl_interop
            local sys32="/mnt/c/Windows/System32"
            if [ "$action" = "reboot" ]; then
                local sd="${sys32}/shutdown.exe"
                [ -x "$sd" ] || sd="shutdown.exe"
                log "Rebooting Windows host..."
                [ -n "${GPUDEV_POWER_DRYRUN:-}" ] && { echo "[dry-run] $sd /r /t 0"; return 0; }
                "$sd" /r /t 0
            else
                local rd="${sys32}/rundll32.exe"
                [ -x "$rd" ] || rd="rundll32.exe"
                log "Sleeping Windows host..."
                # SetSuspendState <Hibernate=0> <Force=1> <WakeupEventsDisabled=0>
                [ -n "${GPUDEV_POWER_DRYRUN:-}" ] && { echo "[dry-run] $rd powrprof.dll,SetSuspendState 0,1,0"; return 0; }
                "$rd" powrprof.dll,SetSuspendState 0,1,0
            fi
            ;;
        linux|"")
            # Bare Linux host. An SSH session is not a polkit "active" session,
            # so suspend/reboot go through sudo (linux-setup.sh adds a NOPASSWD
            # rule for exactly these two commands).
            local sysctl_action
            sysctl_action="$([ "$action" = "reboot" ] && echo reboot || echo suspend)"
            log "Running: systemctl $sysctl_action"
            [ -n "${GPUDEV_POWER_DRYRUN:-}" ] && { echo "[dry-run] sudo systemctl $sysctl_action"; return 0; }
            sudo systemctl "$sysctl_action"
            ;;
        *)
            fail "Unknown host_env '$host_env' in host.json — expected 'wsl2' or 'linux'."
            ;;
    esac
}

power_duration_seconds() {
    local duration="$1" amount unit multiplier
    if [[ ! "$duration" =~ ^([1-9][0-9]*)([smhd])$ ]]; then
        return 1
    fi
    amount="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]}"
    case "$unit" in
        s) multiplier=1 ;;
        m) multiplier=60 ;;
        h) multiplier=3600 ;;
        d) multiplier=86400 ;;
    esac
    printf '%s' "$((amount * multiplier))"
}

ensure_power_timer_manager() {
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    systemctl --user show-environment >/dev/null 2>&1 || fail "The gpudev user systemd manager is unavailable.
Run 'gpudev power setup' once to enable persistent scheduled power operations."
}

setup_power_management() {
    require_host_setup
    command_exists loginctl || fail "loginctl is required to configure scheduled power operations."
    log "Enabling persistent scheduled power operations for $(whoami)..."
    sudo loginctl enable-linger "$(whoami)"
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    local dispatcher="${HOME}/bin/gpudev-ssh-dispatch"
    if [ ! -x "$dispatcher" ] && [ -f "${REPO_DIR}/gpudev-ssh-dispatch" ]; then
        mkdir -p "${HOME}/bin"
        cp "${REPO_DIR}/gpudev-ssh-dispatch" "$dispatcher"
        chmod +x "$dispatcher"
    fi
    [ -x "$dispatcher" ] || fail "SSH dispatcher is missing. Run 'gpudev self-update', then repeat this command."
    "$dispatcher" --install "$HOST_CONFIG"

    echo "Remote power commands are ready:"
    echo "  ssh gpudev sleep"
    echo "  ssh gpudev sleep 60m"
    echo "  ssh gpudev reboot 15m"
    echo "  ssh gpudev power status"
}

schedule_power_action() {
    local action="$1" duration="$2" seconds unit gpudev_bin target_time
    seconds="$(power_duration_seconds "$duration")" || fail "Invalid duration '$duration'. Use an explicit unit, for example: 30s, 60m, 2h, or 1d."
    ensure_power_timer_manager

    unit="gpudev-power-${action}-$(date +%s%N)"
    gpudev_bin="${HOME}/bin/gpudev"
    [ -x "$gpudev_bin" ] || gpudev_bin="$(realpath "${BASH_SOURCE[0]}")"
    target_time="$(date -d "+${seconds} seconds" '+%Y-%m-%d %H:%M:%S %Z')"

    if [ -n "${GPUDEV_POWER_DRYRUN:-}" ]; then
        echo "[dry-run] systemd-run --user --on-active=${seconds}s ${gpudev_bin} power ${action} now"
    else
        systemd-run --user \
            --unit "$unit" \
            --on-active="${seconds}s" \
            --timer-property=AccuracySec=1s \
            --collect \
            "$gpudev_bin" power "$action" now >/dev/null
    fi

    echo "Scheduled power action: ${action}"
    echo "  When:  ${target_time} (in ${duration})"
    echo "  Job:   ${unit}"
    echo "  View:  ssh gpudev power status"
    echo "  Cancel: ssh gpudev power cancel ${unit}"
}

power_timer_units() {
    local pattern="${1:-gpudev-power-*}"
    ensure_power_timer_manager
    systemctl --user list-units --all --type=timer --no-legend "${pattern}.timer" 2>/dev/null \
        | awk '{sub(/\.timer$/, "", $1); print $1}'
}

power_status() {
    ensure_power_timer_manager
    local timers unit action next
    timers="$(power_timer_units)"
    echo "Scheduled gpudev power operations"
    echo ""
    if [ -z "$timers" ]; then
        echo "  None."
    else
        printf "  %-49s %-8s %s\n" "JOB" "ACTION" "WHEN"
        while IFS= read -r unit; do
            [ -n "$unit" ] || continue
            action="${unit#gpudev-power-}"
            action="${action%%-*}"
            next="$(systemctl --user show "${unit}.timer" --property=NextElapseUSecRealtime --value 2>/dev/null || true)"
            [ -n "$next" ] || next="pending"
            printf "  %-49s %-8s %s\n" "$unit" "$action" "$next"
        done <<< "$timers"
    fi
}

cancel_power_timers() {
    local selector="${1:-all}" pattern timers unit count=0
    case "$selector" in
        all) pattern="gpudev-power-*" ;;
        sleep|reboot) pattern="gpudev-power-${selector}-*" ;;
        *)
            if [[ "$selector" =~ ^gpudev-power-(sleep|reboot)-[0-9]+$ ]]; then
                pattern="$selector"
            else
                fail "Unknown scheduled job '$selector'. Use all, sleep, reboot, or the job ID shown by power status."
            fi
            ;;
    esac

    timers="$(power_timer_units "$pattern")"
    if [ -z "$timers" ]; then
        echo "No matching scheduled power operations."
        return 0
    fi
    while IFS= read -r unit; do
        [ -n "$unit" ] || continue
        systemctl --user stop "${unit}.timer" >/dev/null
        echo "Cancelled: ${unit}"
        count=$((count + 1))
    done <<< "$timers"
    echo "Cancelled ${count} scheduled operation(s)."
}

cmd_power() {
    local action="${1:-}" when="${2:-}" extra="${3:-}"
    [ -z "$extra" ] || fail "Too many arguments. Use: gpudev power <sleep|reboot> [now|duration]"
    case "$action" in
        setup)
            [ -z "$when" ] || fail "Usage: gpudev power setup"
            setup_power_management
            ;;
        sleep|reboot)
            case "$when" in
                ""|now) execute_power_action "$action" ;;
                *) schedule_power_action "$action" "$when" ;;
            esac
            ;;
        status)
            [ -z "$when" ] || fail "Usage: gpudev power status"
            power_status
            ;;
        cancel)
            cancel_power_timers "${when:-all}"
            ;;
        *)
            fail "Usage: gpudev power <sleep|reboot> [now|30s|60m|2h|1d]
       gpudev power setup
       gpudev power status
       gpudev power cancel [all|sleep|reboot|job-id]"
            ;;
    esac
}

# ── gpudev self-update ────────────────────────────────────────────────────────

cmd_self_update() {
    local repo_dir="${HOME}/gpudev"
    mkdir -p "$repo_dir"

    # Two modes:
    #   - Git checkout (~/gpudev/.git exists): operator dev workflow → `git pull`.
    #   - Curl-bootstrapped (no .git): production host → download fresh copies
    #     from GitHub raw URLs. Same files linux-setup.sh's fetch_companions
    #     downloads on install; CRAFT.py / windows-setup.ps1 deliberately
    #     excluded — host doesn't need them.
    if [ -d "${repo_dir}/.git" ]; then
        log "Updating ${repo_dir} via git pull..."
        ( cd "$repo_dir" && git pull --ff-only ) || fail "git pull failed in ${repo_dir}."
        ( cd "$repo_dir" && git rev-parse HEAD 2>/dev/null ) \
            > "${repo_dir}/.self-update-sha" 2>/dev/null \
            || rm -f "${repo_dir}/.self-update-sha"
    else
        # Pin the download to a resolved COMMIT SHA, never the branch name.
        # raw.githubusercontent.com serves branch URLs through a CDN with a
        # multi-minute TTL, so `.../main/gpudev` can still return the previous
        # commit's bytes right after a push. self-update then reported
        # "scripts updated" while installing the OLD file — a silent no-op that
        # claims success (observed: a fix took ~140s to appear on the branch
        # URL). A SHA-pinned path is immutable, so what comes back is either
        # that exact commit or an error.
        local repo_raw="${GPUDEV_REPO_RAW:-https://raw.githubusercontent.com/rleyvasal/gpudev/main}"
        command_exists curl || fail "curl is required for self-update on non-git installs."

        # Derive owner/repo/ref from the raw base URL so GPUDEV_REPO_RAW keeps working.
        local repo_path="${repo_raw#https://raw.githubusercontent.com/}"
        local repo_slug="${GPUDEV_REPO_SLUG:-}" repo_ref="${GPUDEV_REPO_REF:-}"
        # Only parse owner/repo/ref out of a real raw.githubusercontent.com URL.
        # A custom mirror leaves repo_path == repo_raw, and slicing that on "/"
        # yields nonsense like "https:/" in the warning below.
        if [ -z "$repo_slug" ] && [ "$repo_path" != "$repo_raw" ]; then
            repo_slug="$(printf '%s' "$repo_path" | cut -d/ -f1-2)"
            if [ -z "$repo_ref" ]; then
                repo_ref="$(printf '%s' "$repo_path" | cut -d/ -f3)"
            fi
        fi
        [ -n "$repo_ref" ] || repo_ref="main"

        local sha="" base
        if [ -n "$repo_slug" ] && command_exists python3; then
            sha="$(curl -fsSL --max-time 15 \
                    "https://api.github.com/repos/${repo_slug}/commits/${repo_ref}" 2>/dev/null \
                  | python3 -c 'import json,sys
try: print(json.load(sys.stdin)["sha"])
except Exception: pass' 2>/dev/null || true)"
        fi

        if [ -n "$sha" ]; then
            base="https://raw.githubusercontent.com/${repo_slug}/${sha}"
            log "Downloading host scripts from ${repo_slug} @ ${sha:0:7} (SHA-pinned)..."
        else
            base="$repo_raw"
            warn "Could not resolve a commit SHA for ${repo_slug:-$repo_raw}."
            warn "Falling back to the unpinned URL, which a CDN may serve stale."
            warn "If a just-pushed change is missing, re-run self-update in a few minutes."
            log "Downloading host scripts from ${base}..."
        fi

        local f tmp
        for f in linux-setup.sh gpudev gpudev-ssh-dispatch client-setup.sh kernel-manager.sh; do
            tmp="$(mktemp)"
            if ! curl -fsSL --max-time 60 "${base}/${f}" -o "$tmp"; then
                rm -f "$tmp"
                fail "Failed to download ${f} from ${base}."
            fi
            # A CDN error page or a truncated body is still a 200 with bytes in
            # it; every file here is a shell script, so require the shebang and
            # a plausible size before it can replace a working script.
            if [ "$(head -c2 "$tmp" 2>/dev/null)" != "#!" ] || [ ! -s "$tmp" ]; then
                rm -f "$tmp"
                fail "Downloaded ${f} does not look like a script — refusing to install it."
            fi
            chmod +x "$tmp"
            mv -f "$tmp" "${repo_dir}/${f}"
            log "  Updated: ${repo_dir}/${f}"
        done
        # Not `[ -n ... ] && ...`: as the last statement of this branch an empty
        # sha would make the AND-list return non-zero and trip `set -e`.
        if [ -n "$sha" ]; then
            printf '%s\n' "$sha" > "${repo_dir}/.self-update-sha"
        else
            # Drop a marker from an earlier pinned run: this run could not verify
            # which commit it installed, so it must not report one.
            rm -f "${repo_dir}/.self-update-sha"
        fi
    fi

    # Deploy CLI scripts from REPO_DIR into ~/bin using atomic mv. Never cp
    # over the running script: bash reads by byte offset, so truncating the
    # same inode mid-run corrupts execution ("unexpected EOF"). rename(2)
    # swaps the directory entry while the old inode stays open for any
    # process still reading it (including this one).
    local script tmp
    for script in gpudev gpudev-ssh-dispatch client-setup.sh kernel-manager.sh; do
        if [ -f "${repo_dir}/${script}" ]; then
            tmp="$(mktemp "${HOME}/bin/.${script}.XXXXXX")"
            cp "${repo_dir}/${script}" "$tmp"
            chmod +x "$tmp"
            mv -f "$tmp" "${HOME}/bin/${script}"
            log "Updated: ${HOME}/bin/${script}"
        else
            warn "${script} not found in ${repo_dir} — skipped."
        fi
    done

    if [ -x "${HOME}/bin/gpudev-ssh-dispatch" ] && [ -f "$HOST_CONFIG" ]; then
        "${HOME}/bin/gpudev-ssh-dispatch" --install "$HOST_CONFIG"
    fi

    # Ensure the interactive-login dashboard hook is in ~/.bashrc so existing
    # hosts get it on `gpudev self-update` (not just fresh linux-setup.sh runs).
    local hook='if [ -n "$PS1" ] && command -v gpudev >/dev/null 2>&1; then gpudev status 2>/dev/null; fi'
    local bashrc="${HOME}/.bashrc"
    touch "$bashrc"
    if ! grep -Fqx "$hook" "$bashrc"; then
        echo "$hook" >> "$bashrc"
        log "Installed dashboard hook into ~/.bashrc (shows on interactive SSH login)."
    fi

    echo ""
    if [ -f "${repo_dir}/.self-update-sha" ]; then
        echo "gpudev scripts updated (commit $(cut -c1-7 "${repo_dir}/.self-update-sha"))."
    else
        echo "gpudev scripts updated."
    fi
}

# ── Usage ─────────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
gpudev — GPU workspace manager

Dashboard:
  gpudev status                (auto-runs on interactive SSH login)

Host:
  gpudev host status

Clients:
  gpudev client list
  gpudev client add <name> [--variant cuda-dev]
  gpudev client invite <name>
  gpudev image list
  gpudev image build cuda-dev
  gpudev client remove <name> [--yes]
  gpudev client start <name>
  gpudev client stop <name>
  gpudev client restart <name>
  gpudev client rebuild <name|--all> [--reset-venv]
  gpudev client logs <name>
  gpudev client info <name>

Kernel:
  gpudev kernel status <name>
  gpudev kernel restart <name>
  gpudev kernel doctor <name>

Status:
  gpudev gpu
  gpudev cloudflare [status|token-set]
  gpudev disk

Power:
  gpudev power setup
  gpudev power sleep [now|30s|60m|2h|1d]
  gpudev power reboot [now|30s|60m|2h|1d]
  gpudev power status
  gpudev power cancel [all|sleep|reboot|job-id]

Other:
  gpudev self-update
EOF
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
    case "${1:-}" in
        status)
            cmd_status
            ;;
        host)
            case "${2:-}" in
                status) cmd_host_status ;;
                *)      usage; exit 1 ;;
            esac
            ;;
        image)
            cmd_image "${2:-}" "${3:-}"
            ;;
        client)
            case "${2:-}" in
                list)    cmd_client_list ;;
                add)     shift 2; cmd_client_add "$@" ;;
                invite)  cmd_client_invite "${3:-}" ;;
                remove)  cmd_client_remove "${3:-}" "${4:-}" ;;
                start)   cmd_client_start "${3:-}" ;;
                stop)    cmd_client_stop "${3:-}" ;;
                restart) cmd_client_restart "${3:-}" ;;
                rebuild) cmd_client_rebuild "${3:-}" "${4:-}" ;;
                logs)    cmd_client_logs "${3:-}" ;;
                info)    cmd_client_info "${3:-}" ;;
                *)       usage; exit 1 ;;
            esac
            ;;
        kernel)
            cmd_kernel "${2:-}" "${3:-}"
            ;;
        gpu)
            cmd_gpu
            ;;
        cloudflare)
            cmd_cloudflare "${2:-}" "${3:-}"
            ;;
        disk)
            cmd_disk
            ;;
        power)
            cmd_power "${2:-}" "${3:-}" "${4:-}"
            ;;
        self-update)
            cmd_self_update
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            usage; exit 1
            ;;
    esac
}

main "$@"
