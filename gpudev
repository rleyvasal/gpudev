print_solveit_bootstrap() {
    local name="$1" hostname="$2"

    echo "── SolveIt bootstrap ──"
    echo ""
    echo "Step 2 of 4 — paste Cell 1 into SolveIt to install or update CRAFT:"
    echo ""
    cat <<'EOF'
%%bash
set -e
mkdir -p /app/data/gpudevd
if [ -d /app/data/gpudevd/gpudev/.git ]; then
  git -C /app/data/gpudevd/gpudev pull --ff-only
else
  git clone https://github.com/rleyvasal/gpudev.git /app/data/gpudevd/gpudev
fi
EOF
    echo ""
    echo "Still Step 2 — paste Cell 2 to create/reuse the key and SSH connection:"
    echo ""
    cat <<EOF
%run /app/data/gpudevd/gpudev/CRAFT.py
%gpu_setup ${name} --hostname ${hostname}
EOF
    echo ""
    echo "Step 3 of 4 — the private key stays in SolveIt. Paste only the PUBLIC"
    echo "key printed by setup into: gpudev client add ${name}"
    echo "Step 4 of 4 — connect each notebook independently with: %gpu ${name}"
    echo "No JSON file, manual SSH edit, terminal login, or host-key prompt is needed."
