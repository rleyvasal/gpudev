#!/usr/bin/env bash
set -euo pipefail

# gpudev — host management CLI
# Manages Docker-based GPU client containers on WSL2 or bare Linux.

CONFIG_DIR="${HOME}/.config/gpudev"
HOST_CONFIG="${CONFIG_DIR}/host.json"
CLIENTS_CONFIG="${CONFIG_DIR}/clients.json"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Source of truth for the management scripts (client-setup.sh, kernel-manager.sh).
# When invoked from the installed ~/bin copy, prefer the git checkout (~/gpudev),
# which is what `git pull` updates — otherwise `add`/`rebuild` would deploy the
# stale ~/bin copies (only `self-update` refreshes those) into containers.
REPO_DIR="$SCRIPT_DIR"
if [ "$REPO_DIR" = "${HOME}/bin" ] && [ -f "${HOME}/gpudev/gpudev" ]; then
    REPO_DIR="${HOME}/gpudev"
fi
CLIENT_SETUP="${REPO_DIR}/client-setup.sh"
BASE_IMAGE="gpudev-base:latest"

log()  { echo "$*"; }
warn() { echo "Warning: $*" >&2; }
fail() { echo "Error: $*" >&2; exit 1; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

sanitize_client_name() {
    printf '%s' "$1" \
      | tr '[:upper:]' '[:lower:]' \
      | sed -E 's/[^a-z0-9-]+/-/g; s/-+/-/g; s/^-+//; s/-+$//'
}

# Resolve a usable nvidia-smi. On WSL2 the NVIDIA driver lives on Windows and
# its Linux-side stub is at /usr/lib/wsl/lib/nvidia-smi — which isn't always on
# PATH (Ubuntu only adds it via libnvidia-container packaging). Try PATH first,
# then the WSL stub. Prints the resolved path; returns 1 if neither exists.
find_nvidia_smi() {
    if command_exists nvidia-smi; then
        command -v nvidia-smi
        return 0
    fi
    if [ -x /usr/lib/wsl/lib/nvidia-smi ]; then
        echo /usr/lib/wsl/lib/nvidia-smi
        return 0
    fi
    return 1
}

# ── Docker wrapper (sudo fallback) ────────────────────────────────────────────

docker_cmd() {
    if docker info >/dev/null 2>&1; then
        docker "$@"
    else
        sudo docker "$@"
    fi
}

# ── Config helpers ────────────────────────────────────────────────────────────

require_host_setup() {
    [ -f "$HOST_CONFIG" ]   || fail "Host not set up. Run linux-setup.sh first."
    [ -f "$CLIENTS_CONFIG" ] || fail "clients.json missing. Run linux-setup.sh first."
}

host_get() {
    local field="$1"
    python3 -c "
import json, pathlib
d = json.loads(pathlib.Path('${HOST_CONFIG}').read_text())
print(d.get('${field}', ''))
"
}

ml_profile_summary() {
    python3 - "$HOST_CONFIG" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
p = json.loads(path.read_text()).get("ml_profile", {}) if path.exists() else {}
if not p:
    print("not resolved — run linux-setup.sh")
else:
    backend = p.get("resolved_backend", "unknown")
    torch = p.get("torch", "unknown")
    count = len(p.get("gpus", []))
    validated = p.get("validated_gpu_count", 0)
    print(f"torch {torch}, {backend}, {validated}/{count} GPU(s) validated")
PY
}

client_get() {
    local name="$1" field="$2"
    python3 - "$CLIENTS_CONFIG" "$name" "$field" <<'PY'
import json, sys
data = json.loads(open(sys.argv[1]).read())
client = next((c for c in data["clients"] if c["name"] == sys.argv[2]), None)
print(client.get(sys.argv[3], "") if client else "")
PY
}

# ── Image variants ────────────────────────────────────────────────────────────
# Mirrors client-setup.sh. A client records its variant in clients.json, so
# rebuild and restart put it back on the SAME image it was created on. Records
# written before variants existed have no field, and client_get returns "" for a
# missing key, so they read as "default" and are unaffected.
client_variant() {
    local v
    v="$(client_get "$1" variant 2>/dev/null)"
    case "$v" in
        cuda-dev) echo "cuda-dev" ;;
        *)        echo "default"  ;;
    esac
}

variant_image() {
    case "$1" in
        cuda-dev) echo "gpudev-base-cuda-dev:latest" ;;
        *)        echo "gpudev-base:latest" ;;
    esac
}

# SYS_ADMIN is granted only to cuda-dev: Nsight Compute needs it to read GPU
# counters inside a container, but it is close to root on the host.
variant_run_flags() {
    case "$1" in
        cuda-dev) echo "--cap-add=SYS_ADMIN --cap-add=PERFMON" ;;
        *)        echo "" ;;
    esac
}

# Docker's 64MB default shm kills multi-worker PyTorch DataLoaders.
CLIENT_SHM_SIZE="${GPUDEV_SHM_SIZE:-8g}"

client_exists() {
    local name="$1"
    python3 -c "
import json, sys
data = json.loads(open('${CLIENTS_CONFIG}').read())
sys.exit(0 if any(c['name'] == '${name}' for c in data['clients']) else 1)
"
}

all_client_names() {
    python3 - "$CLIENTS_CONFIG" <<'PY'
import json, sys
data = json.loads(open(sys.argv[1]).read())
for c in data["clients"]:
    print(c["name"])
PY
}

remove_client_from_registry() {
    local name="$1"
    python3 - "$CLIENTS_CONFIG" "$name" <<'PY'
import json, sys
path, name = sys.argv[1], sys.argv[2]
data = json.loads(open(path).read())
data["clients"] = [c for c in data["clients"] if c["name"] != name]
open(path, "w").write(json.dumps(data, indent=2))
PY
    chmod 600 "$CLIENTS_CONFIG"
}

container_status() {
    local name="$1"
    docker_cmd ps -a --filter "name=^${name}$" --format '{{.Status}}' 2>/dev/null | head -1
}

# ── gpudev host ───────────────────────────────────────────────────────────────

cmd_host_status() {
    require_host_setup

    local cf_domain linux_user host_env port_base host_ssh_port host_cf_hostname
    cf_domain="$(host_get cf_domain)"
    linux_user="$(host_get linux_user)"
    host_env="$(host_get host_env)"
    port_base="$(host_get port_base)"
    host_ssh_port="$(host_get host_ssh_port)"
    host_cf_hostname="$(host_get host_cf_hostname)"

    echo "gpudev Host Status"
    echo ""
    echo "  Environment:    $host_env"
    echo "  Linux user:     $linux_user"
    echo "  CF domain:      $cf_domain"
    echo "  Client port base: $port_base"
    echo ""
    echo "  Host SSH port:  $host_ssh_port"
    echo "  Host tunnel:    $host_cf_hostname"
    echo ""

    docker_cmd info >/dev/null 2>&1 \
        && echo "  Docker:         OK" \
        || echo "  Docker:         NOT RUNNING"

    command_exists cloudflared \
        && echo "  cloudflared:    OK" \
        || echo "  cloudflared:    MISSING"

    docker_cmd image inspect "$BASE_IMAGE" >/dev/null 2>&1 \
        && echo "  Base image:     OK ($BASE_IMAGE)" \
        || echo "  Base image:     NOT BUILT — run linux-setup.sh"
    echo "  ML stack:       $(ml_profile_summary)"

    echo ""
    local count
    count="$(python3 -c "import json; d=json.loads(open('$CLIENTS_CONFIG').read()); print(len(d['clients']))")"
    echo "  Clients registered: $count"
    echo ""

    if [ -n "$host_cf_hostname" ]; then
        echo "── Connect to host (via the Cloudflare tunnel) ──"
        echo ""
        echo "  On your admin machine, add to ~/.ssh/config:"
        echo "    Host ${linux_user}"
        echo "      HostName ${host_cf_hostname}"
        echo "      User ${linux_user}"
        echo "      IdentityFile ~/.ssh/<your-admin-key>"
        echo "      IdentitiesOnly yes"
        # Canonical ProxyCommand (same as client info / README / linux-setup):
        # PATH first, then CRAFT/SolveIt install dir; access tcp + %h.
        echo "      ProxyCommand bash -c 'p=\$(command -v cloudflared 2>/dev/null || echo \"\$HOME/.local/bin/cloudflared\"); exec \"\$p\" access tcp --hostname %h'"
        echo "      ServerAliveInterval 30"
        echo "      ServerAliveCountMax 3"
        echo "  then:  ssh ${linux_user}"
        echo "  (port ${host_ssh_port:-52100} is internal to WSL — never 'ssh -p' it directly)"
        echo ""
    fi

    echo "Run 'gpudev client list' to see client details."
}

# ── gpudev client list ────────────────────────────────────────────────────────

cmd_client_list() {
    require_host_setup

    local count
    count="$(python3 -c "import json; d=json.loads(open('$CLIENTS_CONFIG').read()); print(len(d['clients']))")"

    if [ "$count" -eq 0 ]; then
        echo "No clients registered. Run 'gpudev client add <name>' to add one."
        return 0
    fi

    printf "%-16s %-10s %-16s %s\n" "NAME" "PORT" "STATUS" "HOSTNAME"
    echo "──────────────────────────────────────────────────────────────────"

    local cf_domain
    cf_domain="$(host_get cf_domain)"

    local client_rows
    client_rows="$(python3 - "$CLIENTS_CONFIG" <<'PY'
import json, sys
data = json.loads(open(sys.argv[1]).read())
for c in data["clients"]:
    print(f"{c['name']}|{c.get('ssh_port','?')}")
PY
)"

    while IFS='|' read -r name port; do
        local status hostname
        status="$(container_status "$name")"
        [ -z "$status" ] && status="not created"
        hostname="${name}.${cf_domain}"
        printf "%-16s %-10s %-16s %s\n" "$name" "$port" "$status" "$hostname"
    done <<< "$client_rows"
}

# ── gpudev client add ─────────────────────────────────────────────────────────

# Restarting the connector drops every connection it carries — but ONLY those.
# cloudflared dials sshd on localhost, so a session riding the tunnel reports
# 127.0.0.1 as its peer, while a LAN or console session reports a real address.
# Measured on the host:
#   tunnel -> SSH_CONNECTION="127.0.0.1 55396 127.0.0.1 52100"
#   LAN    -> SSH_CONNECTION="192.168.10.59 51214 192.168.10.80 52100"
# Only the first case needs the deferred/detached dance; everywhere else the
# reload can run inline and be VERIFIED before the command returns.
session_rides_tunnel() {
    case "${SSH_CONNECTION%% *}" in
        127.0.0.1|::1) return 0 ;;
        *)             return 1 ;;
    esac
}

# The connector must have started AFTER the last ingress edit. If config.yml is
# newer than the service's start time, cloudflared is still serving the rules it
# loaded at boot and the newest client's hostname answers "websocket: bad
# handshake" — exactly the silent failure this whole path exists to prevent.
connector_is_current() {
    local config_yml="${HOME}/.cloudflared/config.yml" ts started changed
    [ -f "$config_yml" ] || return 0
    command_exists systemctl || return 0
    ts="$(systemctl show gpudev-tunnel -p ActiveEnterTimestamp --value 2>/dev/null)"
    [ -n "$ts" ] || return 0
    started="$(date -d "$ts" +%s 2>/dev/null)" || return 0
    changed="$(stat -c %Y "$config_yml" 2>/dev/null)" || return 0
    [ "$started" -ge "$changed" ]
}

# A host set up before the NOPASSWD grant existed should become self-sufficient
# at the first client change rather than needing a full linux-setup.sh re-run.
# Costs one interactive sudo; skipped silently when there is no TTY to ask on.
install_tunnel_reload_grant() {
    local sudoers_file="/etc/sudoers.d/gpudev-tunnel" user="${USER:-$(whoami)}"
    [ -t 0 ] || return 1
    log "Installing a NOPASSWD grant so future reloads need no password..."
    sudo tee "$sudoers_file" >/dev/null <<EOF || return 1
# gpudev: allow ${user} to reload the tunnel connector after a client change.
${user} ALL=(root) NOPASSWD: /usr/bin/systemctl restart gpudev-tunnel, /bin/systemctl restart gpudev-tunnel
EOF
    sudo chmod 440 "$sudoers_file" || return 1
    if sudo visudo -cf "$sudoers_file" >/dev/null 2>&1; then
        log "  sudoers: reloads no longer prompt for a password."
        return 0
    fi
    warn "tunnel sudoers file failed validation — removing it to avoid breaking sudo."
    sudo rm -f "$sudoers_file"
    return 1
}

reload_tunnel_connector() {
    local tunnel_name="$1"
    echo ""

    # Legacy non-systemd connector: unchanged detached pkill+respawn.
    if ! command_exists systemctl || ! systemctl is-active gpudev-tunnel >/dev/null 2>&1; then
        log "Reloading the cloudflared connector (detached, no systemd unit)."
        setsid bash -c "sleep 3
pkill -f 'cloudflared tunnel run ${tunnel_name}' 2>/dev/null
sleep 1
nohup cloudflared tunnel run '${tunnel_name}' >>'${HOME}/.cloudflared/tunnel.log' 2>&1" \
            >"${HOME}/.cloudflared/reload.log" 2>&1 </dev/null &
        log "Tunnel reload scheduled (detached) — log: ~/.cloudflared/reload.log"
        return 2
    fi

    if session_rides_tunnel; then
        # Restarting now would kill this very shell mid-command. Defer + detach,
        # but the detached process has NO TTY, so it can only use `sudo -n`:
        # make sure that will work before walking away from it.
        if ! sudo -n systemctl show gpudev-tunnel >/dev/null 2>&1; then
            install_tunnel_reload_grant || true
        fi
        if ! sudo -n systemctl show gpudev-tunnel >/dev/null 2>&1; then
            warn "Ingress updated, but the connector still serves the OLD config and this"
            warn "shell rides the tunnel, so the reload cannot run unattended."
            warn "Run this on the host (console or LAN ssh) to finish:"
            warn "  sudo systemctl restart gpudev-tunnel"
            return 0
        fi
        log "This shell rides the connector, so the restart is deferred a few seconds."
        log "The session will drop — reconnect and the new hostname is live."
        setsid bash -c 'sleep 3; sudo -n systemctl restart gpudev-tunnel' \
            >"${HOME}/.cloudflared/reload.log" 2>&1 </dev/null &
        return 0
    fi

    # Not riding the tunnel: restart inline and prove it worked.
    log "Restarting the cloudflared connector to publish the new ingress..."
    if ! sudo -n systemctl restart gpudev-tunnel 2>/dev/null; then
        if [ -t 0 ]; then
            install_tunnel_reload_grant || true
            sudo systemctl restart gpudev-tunnel || {
                warn "Could not restart gpudev-tunnel. Run: sudo systemctl restart gpudev-tunnel"
                return 2
            }
        else
            warn "Ingress updated, but restarting the connector needs a password."
            warn "Run this on the host to finish:"
            warn "  sudo systemctl restart gpudev-tunnel"
            return 2
        fi
    fi

    local tries=20
    while [ $tries -gt 0 ]; do
        if systemctl is-active gpudev-tunnel >/dev/null 2>&1 && connector_is_current; then
            log "Connector reloaded and serving the new ingress."
            return 0
        fi
        sleep 1
        tries=$((tries - 1))
    done
    warn "Connector did not report current within 20s."
    warn "Check: systemctl status gpudev-tunnel"
}

cmd_client_add() {
    local name="" variant="default"
    while [ $# -gt 0 ]; do
        case "$1" in
            --variant)   variant="${2:-}"; shift 2 ;;
            --variant=*) variant="${1#*=}"; shift ;;
            -*)          fail "Unknown option '$1'. Usage: gpudev client add <name> [--variant cuda-dev]" ;;
            *)           [ -z "$name" ] && name="$1" || fail "Unexpected argument '$1'."; shift ;;
        esac
    done
    [ -n "$name" ] || fail "Usage: gpudev client add <name> [--variant cuda-dev]"
    [ -n "$variant" ] || fail "--variant needs a value (default, cuda-dev)."
    [ -f "$CLIENT_SETUP" ] || fail "client-setup.sh not found at $CLIENT_SETUP"

    case "$variant" in
        default|cuda-dev) ;;
        *) fail "Unknown variant '$variant'. Known variants: default, cuda-dev." ;;
    esac

    echo ""
    echo "Paste the SSH public key for client '${name}':"
    local ssh_key
    IFS= read -r ssh_key
    [ -n "$ssh_key" ] || fail "SSH public key is required."

    GPUDEV_VARIANT="$variant" bash "$CLIENT_SETUP" "$name" "$ssh_key"
}

# ── gpudev image build <variant> ──────────────────────────────────────────────

cmd_image() {
    local sub="${1:-}" variant="${2:-}"
    case "$sub" in
        build)
            [ -n "$variant" ] || fail "Usage: gpudev image build <default|cuda-dev>"
            case "$variant" in
                cuda-dev)
                    local setup="${REPO_DIR}/linux-setup.sh"
                    [ -f "$setup" ] || fail "linux-setup.sh not found at $setup (run: gpudev self-update)"
                    echo "Building the cuda-dev image. This is several GB and takes a while."
                    bash "$setup" --build-cuda-dev
                    ;;
                default)
                    fail "The default image is built by linux-setup.sh. Re-run it to rebuild."
                    ;;
                *) fail "Unknown variant '$variant'. Known variants: cuda-dev." ;;
            esac
            ;;
        list|"")
            echo "Images:"
            for img in "gpudev-base:latest" "gpudev-base-cuda-dev:latest"; do
                if docker_cmd image inspect "$img" >/dev/null 2>&1; then
                    local size
                    size="$(docker_cmd image inspect "$img" --format '{{.Size}}' 2>/dev/null || echo 0)"
                    printf '  %-32s built  (%s GB)\n' "$img" "$(( size / 1000000000 ))"
                else
                    printf '  %-32s not built\n' "$img"
                fi
            done
            echo ""
            echo "  gpudev image build cuda-dev   CUDA 12.8 devel + nvcc/ncu/nsys + TensorRT"
            ;;
        *) fail "Usage: gpudev image [list|build <variant>]" ;;
    esac
}

# ── gpudev client remove ──────────────────────────────────────────────────────

cmd_client_remove() {
    local name="${1:-}" confirm="${2:-}"
    [ -n "$name" ] || fail "Usage: gpudev client remove <name> [--yes]"

    require_host_setup
    client_exists "$name" || fail "Client '$name' not found."

    local ssh_port cf_domain tunnel_name _need_tunnel_reload=0
    ssh_port="$(client_get "$name" ssh_port)"
    cf_domain="$(host_get cf_domain)"
    tunnel_name="$(host_get linux_user)"
    local cf_hostname="${name}.${cf_domain}"

    echo "This will permanently remove:"
    echo "  Container:  $name"
    echo "  Volume:     ${name}-data  (ALL CLIENT DATA WILL BE LOST)"
    echo "  Tunnel:     ingress rule for $cf_hostname removed from host tunnel"
    echo "  Registry:   clients.json entry"
    echo ""

    if [ "$confirm" != "--yes" ]; then
        read -r -p "Type the client name to confirm: " confirm_name
        [ "$confirm_name" = "$name" ] || { echo "Aborted."; return 0; }
    fi

    # Stop and remove container
    if docker_cmd ps -a --format '{{.Names}}' | grep -qx "$name"; then
        docker_cmd rm -f "$name"
        log "Container '$name' removed."
    fi

    # Remove volume
    if docker_cmd volume ls --format '{{.Name}}' | grep -qx "${name}-data"; then
        docker_cmd volume rm "${name}-data"
        log "Volume '${name}-data' removed."
    fi

    # Remove ingress rule from host config.yml and reload tunnel
    local config_yml="${HOME}/.cloudflared/config.yml"
    if [ -f "$config_yml" ] && grep -qF "hostname: ${cf_hostname}" "$config_yml"; then
        python3 -c "
import pathlib
p = pathlib.Path('${config_yml}')
lines = p.read_text().splitlines(keepends=True)
out = []
skip_next = False
for line in lines:
    if 'hostname: ${cf_hostname}' in line:
        skip_next = True
        continue
    if skip_next:
        skip_next = False
        continue
    out.append(line)
p.write_text(''.join(out))
"
        log "Ingress rule for $cf_hostname removed from config.yml."
        # Don't reload here — a connector reload drops the `ssh gpudev` session this
        # command rides on, aborting the remove before DNS + registry cleanup. Defer
        # it to the end, detached (reload_tunnel_connector).
        _need_tunnel_reload=1
    fi

    # Remove Cloudflare DNS record via API
    local cf_api_token cf_zone_id
    cf_api_token="$(host_get cf_api_token)"
    if [ -n "$cf_api_token" ]; then
        cf_zone_id="$(curl -sf \
            -H "Authorization: Bearer ${cf_api_token}" \
            -H "Content-Type: application/json" \
            "https://api.cloudflare.com/client/v4/zones?name=${cf_domain}&status=active" \
            | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['result'][0]['id'] if d.get('result') else '')" 2>/dev/null || true)"

        if [ -n "$cf_zone_id" ]; then
            local record_id
            record_id="$(curl -sf \
                -H "Authorization: Bearer ${cf_api_token}" \
                "https://api.cloudflare.com/client/v4/zones/${cf_zone_id}/dns_records?name=${cf_hostname}&type=CNAME" \
                | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['result'][0]['id'] if d.get('result') else '')" 2>/dev/null || true)"

            if [ -n "$record_id" ]; then
                curl -sf -X DELETE \
                    -H "Authorization: Bearer ${cf_api_token}" \
                    "https://api.cloudflare.com/client/v4/zones/${cf_zone_id}/dns_records/${record_id}" \
                    >/dev/null
                log "DNS record for $cf_hostname deleted."
            else
                warn "DNS record for $cf_hostname not found — may already be removed."
            fi
        else
            warn "Could not resolve zone ID for $cf_domain — delete DNS record manually."
        fi
    else
        warn "No cf_api_token in host.json — cannot auto-delete DNS for $cf_hostname."
        warn "  Option A: Cloudflare dashboard → DNS → delete CNAME $cf_hostname"
        warn "  Option B: store a Zone.DNS Edit token, then re-run remove:"
        warn "    gpudev cloudflare token-set   # pastes into host.json"
        warn "  Create token: https://dash.cloudflare.com/profile/api-tokens"
        warn "    Template 'Edit zone DNS' → only zone: $cf_domain"
    fi

    remove_client_from_registry "$name"
    log "Client '$name' removed from registry."
    echo ""
    echo "Client '$name' fully removed."

    # Apply the ingress removal last and detached, so it can't drop this session
    # before the cleanup above finished.
    if [ "$_need_tunnel_reload" = "1" ]; then
        # Returns non-zero when the reload was deferred or needs a manual step;
        # `client remove` has nothing to verify afterwards, so don't trip `set -e`.
        reload_tunnel_connector "$tunnel_name" || true
    fi
}

# ── gpudev client start/stop/restart ─────────────────────────────────────────

cmd_client_start() {
    local name="${1:-}"
    [ -n "$name" ] || fail "Usage: gpudev client start <name>"
    require_host_setup
    client_exists "$name" || fail "Client '$name' not found."
    docker_cmd start "$name"
    log "Container '$name' started."
}

cmd_client_stop() {
    local name="${1:-}"
    [ -n "$name" ] || fail "Usage: gpudev client stop <name>"
    require_host_setup
    client_exists "$name" || fail "Client '$name' not found."
    docker_cmd stop "$name"
    log "Container '$name' stopped."
}

cmd_client_restart() {
    local name="${1:-}"
    [ -n "$name" ] || fail "Usage: gpudev client restart <name>"
    require_host_setup
    client_exists "$name" || fail "Client '$name' not found."
    docker_cmd restart "$name"
    log "Container '$name' restarted."
}

# ── gpudev client rebuild ─────────────────────────────────────────────────────

# Refresh a client's per-client venv against the (possibly rebuilt) base image.
# Runs as a one-shot against the data volume while the container is down, so the
# kernel that boots afterward sees the fixed venv. Two modes:
#   reset=0 (default) — non-destructive: snapshot the user-package manifest, ensure
#           the thin venv + base overlay + pip exist. Fixes pip/overlay without
#           touching installed packages. Safe to run on every rebuild.
#   reset=1 (--reset-venv) — destructive: rebuild the venv from the base image and
#           replay the manifest. Migrates a fat venv to thin / recovers a corrupted
#           one. User FILES (~/work, etc.) are never touched; only ~/.venv is.
# The manifest = packages in the client venv but NOT in /opt/venv, kept at
# ~/.config/user-packages.txt as the recovery net.
refresh_client_venv() {
    local name="$1" reset="${2:-0}"
    # The venv is built against a specific image: it records that image's
    # interpreter path in pyvenv.cfg and overlays that image's /opt/venv. Building
    # it from the wrong image yields a venv the container cannot use.
    local venv_image
    venv_image="$(variant_image "$(client_variant "$name")")"
    if [ "$reset" = "1" ]; then
        log "  Resetting venv from base image + manifest (user files untouched)..."
    else
        log "  Refreshing venv overlay + manifest..."
    fi
    docker_cmd run --rm \
        -e "RESET=${reset}" \
        -v "${name}-data:/home/gpudev" \
        "$venv_image" bash -c '
set -e
HOME_DIR=/home/gpudev
VENV="$HOME_DIR/.venv"
BASE=/opt/venv
SP=lib/python3.12/site-packages
MANIFEST="$HOME_DIR/.config/user-packages.txt"
mkdir -p "$HOME_DIR/.config"

# 1. Snapshot the user delta (read-only): distributions in the client venv that are
#    not in the base image. Refreshed every run so the recovery manifest stays current.
if [ -x "$VENV/bin/python" ]; then
    comm -13 \
        <(uv pip freeze --python "$BASE/bin/python"  2>/dev/null | sort) \
        <(uv pip freeze --python "$VENV/bin/python" 2>/dev/null | sort) \
        > "$MANIFEST.tmp" && mv "$MANIFEST.tmp" "$MANIFEST" || rm -f "$MANIFEST.tmp"
    echo "  Manifest: $(wc -l < "$MANIFEST" 2>/dev/null || echo 0) user package(s) recorded."
fi

# 2. Destructive reset (opt-in): drop the venv so it is rebuilt from base + manifest.
if [ "${RESET:-0}" = "1" ]; then
    rm -rf "$VENV"
fi

# 3. Ensure a thin venv exists (after a reset, or for a fresh volume).
if [ ! -x "$VENV/bin/python" ]; then
    uv venv "$VENV" --python 3.12 --seed
fi

# 4. Ensure bare pip exists (venvs created before --seed lack it).
if [ ! -x "$VENV/bin/pip" ]; then
    uv pip install --python "$VENV/bin/python" -q pip || true
fi

# 5. Ensure the base overlay .pth is present and correct (idempotent).
echo "$BASE/$SP" > "$VENV/$SP/zzz_base_overlay.pth"

# 6. On reset, replay the user packages into the fresh thin venv.
if [ "${RESET:-0}" = "1" ] && [ -s "$MANIFEST" ]; then
    uv pip install --python "$VENV/bin/python" -r "$MANIFEST" \
        || echo "  Note: some packages failed to replay (editable/local/private installs); see above."
fi
echo "  Venv ready (thin + base overlay)."
'
}

rebuild_one() {
    local name="$1"
    local reset="${2:-0}"
    local ssh_port
    ssh_port="$(client_get "$name" ssh_port)"

    # Rebuild onto the image this client was CREATED on, not the default. Without
    # this a cuda-dev client silently drops back to the standard image on rebuild,
    # losing its toolchain and leaving a venv that references the other image.
    local variant image extra_flags
    variant="$(client_variant "$name")"
    image="$(variant_image "$variant")"
    extra_flags="$(variant_run_flags "$variant")"
    docker_cmd image inspect "$image" >/dev/null 2>&1 \
        || fail "Client '$name' needs image '$image' (variant: $variant), which is not built.
Build it with: gpudev image build $variant"

    log "Rebuilding '$name' (volume data preserved, variant: $variant)..."

    if docker_cmd ps -a --format '{{.Names}}' | grep -qx "$name"; then
        docker_cmd rm -f "$name"
    fi

    # Refresh the in-volume management script so rebuild picks up repo changes
    # (sourced from REPO_DIR — not the deployed ~/bin copy).
    local km_src="${REPO_DIR}/kernel-manager.sh"
    if [ -f "$km_src" ]; then
        docker_cmd run --rm \
            -v "${name}-data:/home/gpudev" \
            -v "${km_src}:/tmp/kernel-manager.sh:ro" \
            "$image" bash -c "
mkdir -p /home/gpudev/bin
cp /tmp/kernel-manager.sh /home/gpudev/bin/kernel-manager.sh
chmod +x /home/gpudev/bin/kernel-manager.sh
"
        log "  Refreshed kernel-manager.sh from repo."
    fi

    # Refresh start.sh so rebuilds pick up persistent SSH host-key logic (and any
    # other startup fixes) without requiring client remove/re-add.
    local cs_src="${REPO_DIR}/client-setup.sh"
    if [ ! -f "$cs_src" ] && [ -f "$CLIENT_SETUP" ]; then
        cs_src="$CLIENT_SETUP"
    fi
    if [ -f "$cs_src" ]; then
        bash "$cs_src" --refresh-start "$name"
    else
        warn "  client-setup.sh not found — start.sh not refreshed (SSH host keys may still rotate)."
    fi

    # Refresh the venv against the (possibly rebuilt) base image BEFORE the container
    # boots, so the kernel starts against the corrected venv. Container is down here,
    # so the data volume is free for the one-shot.
    refresh_client_venv "$name" "$reset"

    # --hostname gpudev-<name>: prompt becomes gpudev@gpudev-<name>:~$ after SSH.
    # shellcheck disable=SC2086
    docker_cmd run -d \
        --name "$name" \
        --hostname "gpudev-${name}" \
        --gpus all \
        --shm-size="$CLIENT_SHM_SIZE" \
        $extra_flags \
        --restart unless-stopped \
        -v "${name}-data:/home/gpudev" \
        -p "127.0.0.1:${ssh_port}:22" \
        -e "GPUDEV_CLIENT=${name}" \
        -e "GPUDEV_VARIANT=${variant}" \
        "$image" \
        "/home/gpudev/start.sh"

    local tries=15
    while [ $tries -gt 0 ]; do
        docker_cmd exec "$name" pgrep sshd >/dev/null 2>&1 && { log "  '$name' ready."; return 0; }
        sleep 2
        tries=$((tries - 1))
    done
    warn "  '$name' may not be fully ready. Check: gpudev client logs $name"
}

cmd_client_rebuild() {
    local target="${1:-}"
    local reset=0
    [ "${2:-}" = "--reset-venv" ] && reset=1
    [ -n "$target" ] || fail "Usage: gpudev client rebuild <name|--all> [--reset-venv]"
    require_host_setup

    if [ "$target" = "--all" ]; then
        local names
        names="$(all_client_names)"
        [ -n "$names" ] || { log "No clients registered."; return 0; }
        log "Rebuilding all clients..."

        local failures=()
        local name logf reason
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            logf="$(mktemp)"
            # Run in a pipeline so a hard failure (rebuild_one calls `fail`,
            # which exits) is contained to the subshell and doesn't abort the
            # whole batch. Output still streams live via tee; we keep a copy to
            # extract the failure reason for the summary.
            if rebuild_one "$name" "$reset" 2>&1 | tee "$logf"; then
                :
            else
                reason="$(grep -aE '^(Error|Warning):' "$logf" | tail -n 1)"
                [ -n "$reason" ] || reason="$(tail -n 1 "$logf")"
                [ -n "$reason" ] || reason="unknown error (no output)"
                failures+=("${name} — ${reason}")
                warn "Skipping '${name}' and continuing with the rest: ${reason}"
            fi
            rm -f "$logf"
        done <<< "$names"

        if [ ${#failures[@]} -gt 0 ]; then
            echo ""
            warn "Rebuild finished with ${#failures[@]} failure(s):"
            local f
            for f in "${failures[@]}"; do
                warn "  - ${f}"
            done
            return 1
        fi
        log "All clients rebuilt."
    else
        client_exists "$target" || fail "Client '$target' not found."
        rebuild_one "$target" "$reset"
    fi
}

